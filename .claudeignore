# .claudeignore — keep Claude Code out of generated/binary noise.
# Affects only what the agent reads/searches; has NO effect on git, builds, or runtime.
# Rationale + measured sizes are in the PHASE-1/2 audit (see CLAUDE.md).

# --- Dependencies (559 MB) — never a source of truth; read package.json instead ---
node_modules/

# --- Build & framework output (.next 21 MB) — regenerated by `npm run build` ---
.next/
dist/
out/

# --- Local database state (.pgdata 40 MB, WASM/binary) — created by PGlite at runtime ---
.pgdata/
*.db
*.db-shm
*.db-wal
*.sqlite

# --- Generated drizzle migration snapshots (688 KB across 13 files) ---
# Pure machine-generated JSON; the human-readable truth is the *.sql files + db/schema.ts.
db/migrations/meta/

# --- Lockfile (241 KB generated) — dependency truth lives in package.json ---
package-lock.json

# --- TS/build incremental caches ---
*.tsbuildinfo
tsconfig.tsbuildinfo

# --- Logs / temp / coverage / reports ---
*.log
logs/
coverage/
.nyc_output/
*.tmp
tmp/
.cache/

# --- Media / binary assets (none tracked today; defensive) ---
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.mp4
*.mov
*.pdf
*.zip

# --- Env files (secrets) ---
.env*

# NOTE: intentionally NOT ignored (high-value, read on demand):
#   LaunchOS-Spec.md, launchos_schema.sql  — large but canonical references
#   docs/superpowers/**                     — historical specs/plans (design rationale)
